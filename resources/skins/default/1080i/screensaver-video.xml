<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
    <controls>
        <control type="image">
            <description>background</description>
            <texture>black.jpg</texture>
            <width>100%</width>
            <height>100%</height>
        </control>
        <control type="group">
            <visible>String.IsEqual(Window.Property(screensaver-video-loading), "true")</visible>
            <control type="image">
                <description>Busy animation</description>
                <posx>40</posx>
                <posy>1000</posy>
                <width>30</width>
                <height>30</height>
                <texture>busy.png</texture>
                <aspectratio>keep</aspectratio>
                <animation effect="rotate" start="0" end="360" center="55,1015" time="1200" loop="true" condition="true">conditional</animation>
            </control>
            <control type="label" id="32502">
                <top>975</top>
                <left>90</left>
                <width>600</width>
                <height>90</height>
                <font>font11</font>
                <textcolor>88FFFFFF</textcolor>
                <aligny>center</aligny>
                <align>left</align>
                <label></label>
            </control>
        </control>
        <control type="label" id="32503">
            <centerx>50%</centerx>
            <centery>50%</centery>
            <width>80%</width>
            <height>auto</height>
            <font>font13</font>
            <textcolor>FFFFFFFF</textcolor>
            <align>center</align>
            <aligny>center</aligny>
            <label></label>
            <visible>!String.IsEqual(Window.Property(screensaver-video-loading), "true")</visible>
        </control>
        <control type="videowindow">
            <description>VideoWindow</description>
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>
            <visible>!String.IsEqual(Window.Property(screensaver-video-loading), "true")</visible>
        </control>
    </controls>
</window>
